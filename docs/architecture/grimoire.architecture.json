  "cards": [
    { "title": "Who writes what", "color": "rose", "items": ["The graph never writes code: indexing is a script, queries are read-only SQL.", "The page server writes only Markdown notes, atomically, and refuses a stale save.", "Memory is written by crystallize only, never mid-task."] },

{
  "$comment": "grimoire.config.json — the project's harness configuration. Written by /grimoire:setup, read by /orchestrate, /grimoire:logs, /grimoire:manager and the guard hook. Keep it at the project root.",
  "baseBranch": "origin/main",
  "memoryDir": "memory",
  "runsDir": "runs",
  "requireHook": {
    "name": "rtk hook claude",
    "check": "command -v rtk && rtk hook check \"git status\" | grep -q '^rtk '",
    "fix": "brew install rtk-ai/tap/rtk && rtk init -g, then restart the session",
    "raw": "rtk proxy"
  },
  "preflight": true,
  "maxOutputTokens": 4000000,
  "telemetry": { "enabled": true, "dir": ".grimoire/runs", "retentionDays": 183 },
  "claim": { "identity": "grimoire-bot" },
  "trackerStatus": { "names": { "inReview": "In Review", "blocked": "Blocked" } },
  "toolHints": { "tracker": "mcp__<server-id>__* (Linear, the authenticated claude.ai connector)", "design": "mcp__<server-id>__* (Figma)", "errors": "the error tracker CLI (already authenticated)" },
  "specialists": [
    { "agent": "migration-engineer", "repos": ["api"], "use": "schema and data migrations, expand/contract steps" },
    { "agent": "test-engineer", "repos": ["*"], "use": "putting untested code under test before changing it" }
  ],
  "guard": { "enabled": true, "protectedBranches": ["main", "release/*"] },
  "graph": { "enabled": true, "dir": ".grimoire/graph", "exclude": ["**/generated/**"], "maxFileKB": 512 },
  "manager": {
    "sources": [
      { "id": "linear", "category": "tracker", "kind": "linear", "hint": "mcp__<server-id>__* (Linear, the claude.ai connector)", "readOnly": "guard", "scope": { "teams": ["ENG"] }, "verifiedAt": "2026-10-16T09:30:00Z" },
      { "id": "prs", "category": "prs", "kind": "github", "hint": "gh CLI, authenticated", "readOnly": "guard", "scope": { "repos": ["acme/api", "acme/mobile"] }, "verifiedAt": "2026-10-16T09:30:00Z" },
      { "id": "runs", "category": "runs", "kind": "grimoire" }
    ],
    "urgent": { "priorityAtMost": 2, "dueWithinDays": 2, "blocksAtLeast": 2, "stalledDays": 5 },
    "priorityLabels": { "priority: urgent": 1, "priority: high": 2, "priority: medium": 3, "priority: low": 4, "P0": 1, "P1": 2, "P2": 3, "P3": 4, "critical": 1 },
    "repoLabels": { "backend": "api", "frontend": "mobile", "infra": "infra" },
    "maxItemsPerSource": 200,
    "schedule": { "kind": "desktop-task", "when": "30 8 * * 1-5", "taskId": "grimoire-manager-acme", "verifiedAt": "2026-10-16T09:45:00Z" },
    "$comment": "share: null (the default) shares nothing. Opt in at /grimoire:setup with {kind: linear-document | github-issue | slack-canvas, target, hint}: one rolling post the team reads, replaced by every briefing (workflows/README.md).",
    "share": null,
    "budgetUsd": null
  },
  "repos": [
    {
      "name": "api",
      "path": "repositories/api",
      "remote": "git@github.com:acme/api.git",
      "agent": "api-engineer",
      "tags": ["backend"],
      "gate": { "run": "make e2e-test E2E_LOCK_WAIT=1800", "stamp": "tests/e2e/.e2e-green" },
      "timeoutMin": 60
    },
    {
      "name": "mobile",
      "path": "repositories/mobile",
      "agent": "mobile-engineer",
      "tags": ["mobile"],
      "gate": { "run": "npm run smoke:android && npm run smoke:ios", "when": { "pathsMatching": ["native/", "modules/bridge/"] } },
      "laneSetup": "ln -sfn \"$(cd repositories/mobile && pwd)/node_modules\" <lane>/node_modules"
    },
    { "name": "infra", "path": "repositories/infra", "agent": "infra-engineer", "tags": ["infra"], "gate": null }
  ]
}
